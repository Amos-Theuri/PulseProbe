# PulseProbe Environment Variables Contract

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Docker, or Local PostgreSQL)
# Example (Neon): postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/pulseprobe?sslmode=require
# Example (Local Docker): postgresql://postgres:postgres@localhost:5432/pulseprobe?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseprobe?schema=public"

# Base public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Maximum concurrent probe checks executed in parallel by the scheduler
MONITOR_WORKER_CONCURRENCY="5"

# Default timeout in milliseconds for network probes (default: 5000)
PROBE_DEFAULT_TIMEOUT_MS="5000"

# Number of consecutive failures before escalating to an incident (default: 3)
INCIDENT_FAIL_THRESHOLD="3"

# API key for protecting mutating endpoints (POST/PATCH/DELETE on monitors, worker tick).
# Leave unset to disable auth (dev mode). Set to a strong random string in production.
# PULSEPROBE_API_KEY=""

# Maximum number of monitors allowed (default: 50)
MAX_MONITORS="50"

# Maximum concurrent SSE client connections (default: 100)
MAX_SSE_CLIENTS="100"

